<% content_for :title, "Movies" %>
<section class="page-heading">
  <h1>Movies <span class="count"><%= @movies.size %></span></h1>
  <%= link_to "Add movie", new_movie_path, class: "button primary" %>
</section>
<% if @movies.any? %>
  <section class="collection" aria-label="Movie collection">
    <div class="table-scroll"><table>
      <thead><tr><th scope="col">Title</th><th scope="col">Rating</th><th scope="col">Released</th></tr></thead>
      <tbody><% @movies.each do |movie| %>
        <tr>
          <td><%= link_to movie.title, movie, class: "title-link" %></td>
          <td><%= movie.rating %></td>
          <td class="date"><%= movie.release_date&.strftime("%b %-d, %Y") || "Not specified" %></td>
        </tr>
      <% end %></tbody>
    </table></div>
  </section>
<% else %>
  <section class="empty-state"><h2>No movies yet.</h2><%= link_to "Add your first movie", new_movie_path, class: "button primary" %></section>
<% end %>
